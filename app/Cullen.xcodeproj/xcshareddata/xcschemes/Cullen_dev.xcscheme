      useCustomWorkingDirectory = "NO"
      debugDocumentVersioning = "YES">
      <BuildableProductRunnable
         runnableDebuggingMode = "0">
         <BuildableReference
            BuildableIdentifier = "primary"
            BlueprintIdentifier = "D0C3DE7A2EDD91AD0068307C"
            BuildableName = "Cullen.app"
            BlueprintName = "Cullen"
            ReferencedContainer = "container:Cullen.xcodeproj">
         </BuildableReference>
